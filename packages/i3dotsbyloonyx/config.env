# Configuración de Paquete: i3dotsbyloonyx
# Este archivo es cargado por dots

export WALLPAPER_DIR="$HOME/wall"
export ROFI_THEME="$HOME/.config/rofi/themes/launcher.rasi"

# Persistencia Local
export LAST_WALLPAPER_PATH_FILE="$STATE_DIR/i3/wall"
export CURRENT_WALLPAPER_LINK="$STATE_DIR/i3/current"

# Motor de wallpaper
export WP_ENGINE="feh"

# Directorios de Lógica del Paquete
export HOOK_DIR="$PACKAGE_DIR/hooks"

# Secuencias de ejecución
export DOT_SEQUENCE=(
    "wp_select.sh"
    "engine_hellwal.sh"
    "apply_dots.sh"
)

# Configuración para el módulo core launcher
export LAUNCHER_BIN="rofi"
export LAUNCHER_ARGS="-show drun -theme $PACKAGE_DIR/dotfiles/rofi/themes/launcher.rasi"

# Configuración para el módulo core powermenu
export POWERMENU_BIN="rofi"
export POWERMENU_ARGS="-theme $PACKAGE_DIR/dotfiles/rofi/themes/powermenu.rasi"

# --- CARGA DE VARIANTES ---
if [ -f "$PACKAGE_DIR/.current_variant" ]; then
    VARIANT_NAME=$(cat "$PACKAGE_DIR/.current_variant")
    [ -f "$PACKAGE_DIR/envs/${VARIANT_NAME}.env" ] && source "$PACKAGE_DIR/envs/${VARIANT_NAME}.env"
fi

export MANAGED_COMPONENTS="kitty polybar picom i3 rofi"
