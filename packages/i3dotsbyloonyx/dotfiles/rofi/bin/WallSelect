#!/usr/bin/env bash
# WallSelect - Selector de wallpaper integrado en mahogara-dots

# Redirigir toda la salida a un log para diagnóstico
exec > /tmp/dots_wallselect.log 2>&1

echo "--- Inicio de WallSelect $(date) ---"

# 1. Ruta absoluta al ejecutable dots
DOTS_EXEC="/home/dereck/dev/mahogara-dots/dots"

# 2. Asegurarnos de estar en el directorio correcto
cd "/home/dereck/dev/mahogara-dots" || exit 1

# 3. Ejecutar el orquestador
if [ -x "$DOTS_EXEC" ]; then
    echo "Ejecutando: $DOTS_EXEC i3dotsbyloonyx"
    "$DOTS_EXEC" i3dotsbyloonyx
    echo "Finalizado con código: $?"
else
    echo "ERROR: No se encontró el ejecutable en $DOTS_EXEC"
    exit 1
fi
