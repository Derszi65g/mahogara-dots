* {
    background:     #151310FF;
    background-alt: #4b463bFF;
    foreground:     #e7e2dcFF;
    selected:       #dec998FF;
    active:         #d1c5aeFF;
    urgent:         #ffb4abFF;
    BG:             #151310FF;
    BGA:            #4b463bFF;
    FG:             #e7e2dcFF;
    SEL:            #dec998FF;
    BDR:            #979083FF;
    ON:             #d1c5aeFF;
    OFF:            #ffb4abFF;
}

element selected.normal {
    background-color: var(selected);
    text-color:       var(background);
}

element-text selected {
    text-color:       var(background);
}

element-icon selected {
    text-color:       var(background);
}
