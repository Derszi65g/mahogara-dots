# Configuración de Paquete: Sway
# Este archivo es cargado por dots

export WALLPAPER_DIR="$HOME/wall"
export ROFI_THEME="$HOME/.config/rofi/themes/WallSelecthypr.rasi"

# Persistencia Local (Sway) - Usando el CORE_DIR/state
export LAST_WALLPAPER_PATH_FILE="$STATE_DIR/sway/wall"
export CURRENT_WALLPAPER_LINK="$STATE_DIR/sway/current"

# Motor de wallpaper para Sway
export WP_ENGINE="awww"

# Rutas de componentes dentro del paquete
export WAYBAR_CONFIG_DIR="$PACKAGE_DIR/dotfiles/waybar"
export WAYBAR_BASE_CONFIG_DIR="$WAYBAR_CONFIG_DIR"
export WAYBAR_CONFIG_FILE="$WAYBAR_CONFIG_DIR/config"
export WAYBAR_STYLE_FILE="$WAYBAR_CONFIG_DIR/style.css"
export WAYBAR_THEMES_BASE_DIR="$WAYBAR_CONFIG_DIR/themes/base"
export WAYBAR_THEMES_COLORS_DIR="$WAYBAR_CONFIG_DIR/themes/colors"

export KITTY_CONFIG_DIR="$HOME/.config/kitty"

# Configuración de Hellwal (Matugen-style)
export HELLWAL_TEMPLATES_DIR="$PACKAGE_DIR/templates"
export HELLWAL_CACHE_DIR="$STATE_DIR/hellwal/sway/output/"

# Directorios de Lógica del Paquete
export HOOK_DIR="$PACKAGE_DIR/hooks"

# Temas específicos
export ROFI_LAUNCHER_THEME="$PACKAGE_DIR/dotfiles/rofi/themes/launcher.rasi"


# Secuencias de ejecución
export DOT_SEQUENCE=(
    "wp_select.sh"
    "engine_hellwal.sh"
    "apply_dots.sh"
)

# Acción específica: solo wallpaper y colores
export DOT_SEQUENCE_WALLPAPER=(
    "wp_select.sh"
    "engine_hellwal.sh"
    "apply_dots.sh"
)

# Alias para wall
export DOT_SEQUENCE_WALL=(
    "wp_select.sh"
    "engine_hellwal.sh"
    "apply_dots.sh"
)

# Acción específica: solo recargar componentes (sin menú de wallpaper)
export DOT_SEQUENCE_RELOAD=(
    "engine_hellwal.sh"
    "apply_dots.sh"
)

# Acción específica: Lanzador de aplicaciones
export LAUNCHER_BIN="rofi"
export LAUNCHER_ARGS="-show drun -theme $PACKAGE_DIR/dotfiles/rofi/themes/launcher.rasi"
export LAUNCHER_STYLE_TEMPLATE='inputbar { background-image: url("%s", width); }'

# Configuración para el selector de wallpaper (wp_select.sh)
# --- ROFI (Comentado para experimento) ---
 export WP_SEL_BIN="rofi"
 export WP_SEL_ARGS="-dmenu -p Wallpaper -theme $ROFI_THEME"
 export WP_SEL_STYLE="-theme-str element-icon{size:450px;} -theme-str element-text{horizontal-align:0.5;}"
 export WP_SEL_LINE_TMPL='%f\x00icon\x1f%p'

# --- WOFI (Activado para experimento) ---
# export WP_SEL_BIN="wofi"
# export WP_SEL_ARGS="--dmenu --prompt Wallpaper --style $PACKAGE_DIR/dotfiles/wofi/style.css --width 400 --height 300"
# export WP_SEL_STYLE="" # Wofi no usa theme-str
# export WP_SEL_LINE_TMPL='%f' # Wofi dmenu simple solo acepta texto

export DOT_SEQUENCE_LAUNCHER=(
    "launcher.sh"
)

# Configuración para el módulo core powermenu
export POWERMENU_BIN="rofi"
export POWERMENU_ARGS="-theme $PACKAGE_DIR/dotfiles/rofi/themes/powermenu.rasi"
export POWERMENU_LABEL_SHUTDOWN="⏻"
export POWERMENU_LABEL_REBOOT=""
export POWERMENU_LABEL_SUSPEND=""
export POWERMENU_LABEL_LOGOUT="󰿅"
# Comandos personalizados (opcional)
export POWERMENU_CMD_SUSPEND="mpc -q pause; amixer set Master mute; systemctl suspend"

export DOT_SEQUENCE_POWERMENU=(
    "powermenu.sh"
)

export MANAGED_COMPONENTS="kitty dunst waybarbase waycolor launcher powermenu"

# Mapeo de Componentes
export COMPONENT_KITTY="kitty_colors.conf"
export COMPONENT_WAYBARBASE="modern.css"
export COMPONENT_WAYCOLOR="colors.css"

# --- CARGA DE VARIANTES ---
# Si existe una variante guardada (vía install.sh), la cargamos para sobreescribir valores
if [ -f "$PACKAGE_DIR/.current_variant" ]; then
    VARIANT_NAME=$(cat "$PACKAGE_DIR/.current_variant")
    VARIANT_FILE="$PACKAGE_DIR/envs/${VARIANT_NAME}.env"
    if [ -f "$VARIANT_FILE" ]; then
        source "$VARIANT_FILE"
    fi
fi
